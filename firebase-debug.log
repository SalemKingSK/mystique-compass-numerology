[debug] [2026-04-11T05:38:20.177Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    /**\n     * FIRESTORE SECURITY RULES DOCUMENTATION\n     *\n     * Core Philosophy: \n     * This ruleset implements a strict hierarchical user-ownership model. Access to data is \n     * strictly partitioned by the {userId} present in the document path.\n     *\n     * Data Structure:\n     * All application data is nested under the path /users/{userId}. \n     * - /users/{userId}/setupSessions/{sessionId}: Contains project setup configurations.\n     * - /users/{userId}/setupSessions/{sessionId}/setupSteps/{stepId}: Contains the checklist steps for a session.\n     *\n     * Key Security Decisions:\n     * 1. Path-Based Authorization: We use the {userId} wildcard in the path as the primary \n     *    source of truth for ownership. This provides high-performance rules without \n     *    requiring cross-document lookups (get() calls).\n     * 2. Denormalization for Integrity: On creation, rules enforce that the document's \n     *    internal 'id' and 'sessionId' fields match the path parameters.\n     * 3. Immutability: Critical relational fields (like 'id') are made immutable during updates \n     *    to prevent data from being moved between owners or sessions.\n     * 4. Prototyping Flexibility: Rules do not enforce strict schema types (e.g., string vs bool) \n     *    or field presence for non-relational data to allow for rapid frontend iteration.\n     */\n\n    // --- Helper Functions ---\n\n    /** Checks if the request is from an authenticated user. */\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    /** Checks if the authenticated user matches the userId provided in the path. */\n    function isOwner(userId) {\n      return isSignedIn() && request.auth.uid == userId;\n    }\n\n    /** \n     * Checks if the document exists and the user is the owner. \n     * Used for update and delete operations to ensure state-change integrity.\n     */\n    function isExistingOwner(userId) {\n      return resource != null && isOwner(userId);\n    }\n\n    // --- Collection Rules ---\n\n    /**\n     * @description Rules for managing user-specific setup sessions.\n     * @path /users/{userId}/setupSessions/{sessionId}\n     * @allow (create) if auth.uid matches {userId} and data.id matches {sessionId}.\n     * @deny (list) if auth.uid does not match {userId}.\n     * @principle Restricts access to a user's own data tree and validates path consistency.\n     */\n    match /users/{userId}/setupSessions/{sessionId} {\n      allow get, list: if isOwner(userId);\n      allow create: if isOwner(userId) && request.resource.data.id == sessionId;\n      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;\n      allow delete: if isExistingOwner(userId);\n\n      /**\n       * @description Rules for managing checklist steps within a specific setup session.\n       * @path /users/{userId}/setupSessions/{sessionId}/setupSteps/{stepId}\n       * @allow (update) if auth.uid matches {userId} and the document exists.\n       * @deny (create) if the internal sessionId does not match the path.\n       * @principle Enforces relational integrity between the session and its sub-steps.\n       */\n      match /setupSteps/{stepId} {\n        allow get, list: if isOwner(userId);\n        allow create: if isOwner(userId) && request.resource.data.id == stepId && request.resource.data.sessionId == sessionId;\n        allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id && request.resource.data.sessionId == resource.data.sessionId;\n        allow delete: if isExistingOwner(userId);\n      }\n    }\n    \n    // Explicitly deny access to any other collections not defined here.\n    match /{path=**} {\n      allow read, write: if false;\n    }\n  }\n}"}]}}
